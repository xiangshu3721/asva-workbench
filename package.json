{
  "name": "asva-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "server": "node server/index.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "build:meta": "node scripts/build-metadata.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "auth:data-check": "node scripts/auth-data-check.mjs",
    "customer:data-check": "node scripts/customer-data-check.mjs",
    "evidence:data-check": "node scripts/evidence-data-check.mjs",
    "stage2:provision": "node scripts/stage2-provision.mjs",
    "stage2:integration": "node scripts/stage2-integration-test.mjs",
    "stage1:integration": "node scripts/stage1-integration-test.mjs",
    "stage0:write-test": "node scripts/stage0-write-test.mjs",
    "build": "npm run build:meta && tsc -p tsconfig.json --noEmit && vite build",
    "build:cloudbase": "node scripts/build-cloudbase-function.mjs",
    "deploy:cloudbase": "npm run build:meta && npm run build:cloudbase && node scripts/deploy-cloudbase.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
