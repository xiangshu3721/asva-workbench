{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XSH AI Dev Protocol V1.0 — Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind",
    "task_id",
    "spec_version",
    "spec_sha256",
    "executor",
    "result_state",
    "base_sha",
    "head_sha",
    "branch",
    "acceptance_results",
    "deployment",
    "blockers",
    "deviations",
    "improvement_proposals",
    "summary_for_user",
    "ready_for_release"
  ],
  "properties": {
    "protocol": {
      "const": "XSH_AI_DEV_V1"
    },
    "kind": {
      "const": "result"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "spec_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "result_state": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acceptance_id",
          "status",
          "evidence_refs",
          "note"
        ],
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^AT[0-9]{3,}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_TESTED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "location",
                "summary"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "commit",
                    "test_log",
                    "api_trace",
                    "external_readback",
                    "browser_e2e",
                    "screenshot",
                    "manual_check"
                  ]
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "environment": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "environment",
        "reference",
        "production_writes_performed"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "production_writes_performed": {
          "type": "boolean"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "improvement_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue",
          "proposal"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_for_user": {
      "type": "string",
      "minLength": 1
    },
    "ready_for_release": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result_state": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "spec_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "base_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ready_for_release": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "result_state": {
            "const": "COMPLETE"
          }
        }
      }
    }
  ]
}
