{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XSH AI Dev Protocol V1.0 — Task (YAML parsed to JSON)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind",
    "task_id",
    "spec_version",
    "state",
    "approval",
    "project",
    "intent",
    "scope",
    "authorization",
    "requirements",
    "acceptance",
    "guardrails",
    "stop_conditions",
    "change_requests"
  ],
  "properties": {
    "protocol": {
      "const": "XSH_AI_DEV_V1"
    },
    "kind": {
      "const": "task"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "state": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "EXECUTING",
        "VERIFIED",
        "BLOCKED"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_confirmed",
        "reference"
      ],
      "properties": {
        "user_confirmed": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repo",
        "base_ref",
        "base_sha",
        "verified_facts",
        "assumptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact",
              "source",
              "verified_at"
            ],
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_goal",
        "observable_success",
        "non_goals"
      ],
      "properties": {
        "user_goal": {
          "type": "string",
          "minLength": 1
        },
        "observable_success": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_deploy_allowed",
        "production_write_allowed",
        "merge_allowed"
      ],
      "properties": {
        "production_deploy_allowed": {
          "type": "boolean"
        },
        "production_write_allowed": {
          "type": "boolean"
        },
        "merge_allowed": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "scenario",
          "given",
          "when",
          "then",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3,}$"
          },
          "priority": {
            "enum": [
              "must",
              "should"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_ids",
          "method",
          "environment",
          "expected",
          "evidence_required",
          "release_blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AT[0-9]{3,}$"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^R[0-9]{3,}$"
            }
          },
          "method": {
            "enum": [
              "unit",
              "integration",
              "browser_e2e",
              "manual",
              "performance",
              "static",
              "security"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "commit",
                "test_log",
                "api_trace",
                "external_readback",
                "browser_e2e",
                "screenshot",
                "manual_check"
              ]
            }
          },
          "release_blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "impact",
          "proposal",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROPOSED",
              "APPROVED",
              "REJECTED"
            ]
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "APPROVED",
              "EXECUTING",
              "VERIFIED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "user_confirmed": {
                "const": true
              },
              "reference": {
                "minLength": 8
              }
            }
          },
          "project": {
            "properties": {
              "base_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    }
  ]
}
